# Ordinary Firestore-only compatibility target (optional, explicit cloud opt-in).
VITE_TASKIFY_PROJECT_ID=taskify-dev-dpdhole
# Auth requires the public settings from the registered Firebase Web App.
# Keep actual values in ignored .env.auth.local and select --mode auth.
# Provider client secrets and operator tokens never belong in Vite variables.
VITE_TASKIFY_API_KEY=
VITE_TASKIFY_APP_ID=1:243252492098:web:39b2429e66b2e1f511fadb
VITE_TASKIFY_AUTH_DOMAIN=taskify-dev-dpdhole.firebaseapp.com
