// LOCAL STAGE-INTEGRITY PROBE ONLY. Not a production/deployment policy.
// Fixed seed recipe, fixture-only explicit UTC settings. No ordinary management writes.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function ep(uid,kind,id) { return /databases/$(database)/documents/users/$(uid)/$(kind)/$(id); }
  function ip(uid) { return /databases/$(database)/documents/users/$(uid)/initialization/workspace; }
  function rp(uid,stage) { return /databases/$(database)/documents/users/$(uid)/initializationStages/$(stage); }
  function gp(uid,kind,key) { let digest=hashing.sha256(key).toHexString().lower(); return /databases/$(database)/documents/users/$(uid)/nameKeys/$(kind)/keys/$(digest); }
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function unfenced(uid) { return owner(uid) && !exists(/databases/$(database)/documents/accountDeletion/$(uid)); }
  function allowed(family) { let c=get(/databases/$(database)/documents/runtime/compatibility).data; return c.contractFormatVersion==1 && c.recordFamilies[family].allowedWriteSchemaVersions.hasAny([1]); }
  function meta(d) { return d.schemaVersion==1 && d.recordVersion==1 && d.createdAt==request.time && d.updatedAt==request.time; }
  function initializing(uid) { let i=get(ip(uid)).data; return i.schemaVersion==1 && i.templateVersion==1 && i.status=='initializing'; }
  function previous(stage) { return {"base":"","categories-01":"base","categories-02":"categories-01","categories-03":"categories-02","categories-04":"categories-03","categories-05":"categories-04","categories-06":"categories-05","locations-01":"categories-06","locations-02":"locations-01","locations-03":"locations-02","locations-04":"locations-03","locations-05":"locations-04","locations-06":"locations-05","locations-07":"locations-06","locations-08":"locations-07","locations-09":"locations-08","locations-10":"locations-09","views-01":"locations-10","views-02":"views-01","views-03":"views-02","views-04":"views-03","views-05":"views-04","views-06":"views-05","views-07":"views-06"}[stage]; }
  function prerequisite(uid,stage) { return stage=='base' ? !exists(ip(uid)) : initializing(uid) && exists(rp(uid,previous(stage))); }
  function receiptShape(d) { return d.keys().hasOnly(['schemaVersion','templateVersion','completedAt']) && d.keys().hasAll(['schemaVersion','templateVersion','completedAt']) && d.schemaVersion==1 && d.templateVersion==1 && d.completedAt==request.time; }
  function receiptWritten(uid,stage) { return !exists(rp(uid,stage)) && receiptShape(getAfter(rp(uid,stage)).data); }
  function namedExpected(kind,id) { return kind=="categories" ? (id=="family" ? {"name":"Family","nameKey":"family","icon":"family_restroom","archived":false,"order":1000,"stage":"categories-01"} : id=="finance" ? {"name":"Finance","nameKey":"finance","icon":"wallet","archived":false,"order":2000,"stage":"categories-01"} : id=="friends" ? {"name":"Friends","nameKey":"friends","icon":"group","archived":false,"order":3000,"stage":"categories-02"} : id=="growth" ? {"name":"Growth","nameKey":"growth","icon":"trending_up","archived":false,"order":4000,"stage":"categories-02"} : id=="hobbies" ? {"name":"Hobbies","nameKey":"hobbies","icon":"palette","archived":false,"order":5000,"stage":"categories-03"} : id=="household" ? {"name":"Household","nameKey":"household","icon":"home_and_garden","archived":false,"order":6000,"stage":"categories-03"} : id=="leisure" ? {"name":"Leisure","nameKey":"leisure","icon":"weekend","archived":false,"order":7000,"stage":"categories-04"} : id=="self" ? {"name":"Self","nameKey":"self","icon":"person","archived":false,"order":8000,"stage":"categories-04"} : id=="social" ? {"name":"Social","nameKey":"social","icon":"celebration","archived":false,"order":9000,"stage":"categories-05"} : id=="wellness" ? {"name":"Wellness","nameKey":"wellness","icon":"heart_plus","archived":false,"order":10000,"stage":"categories-05"} : id=="work" ? {"name":"Work","nameKey":"work","icon":"work","archived":false,"order":11000,"stage":"categories-06"} : id=="uncategorized" ? {"name":"Uncategorized","nameKey":"uncategorized","icon":"category","archived":false,"order":12000,"stage":"categories-06"} : {}) : kind=="locations" ? (id=="grocery" ? {"name":"Grocery","nameKey":"grocery","icon":"local_grocery_store","archived":false,"order":1000,"stage":"locations-01"} : id=="gym" ? {"name":"Gym","nameKey":"gym","icon":"fitness_center","archived":false,"order":2000,"stage":"locations-02"} : id=="local-stores" ? {"name":"Local Stores","nameKey":"local stores","icon":"storefront","archived":false,"order":3000,"stage":"locations-03"} : id=="mall" ? {"name":"Mall","nameKey":"mall","icon":"local_mall","archived":false,"order":4000,"stage":"locations-04"} : id=="market" ? {"name":"Market","nameKey":"market","icon":"store","archived":false,"order":5000,"stage":"locations-05"} : id=="office" ? {"name":"Office","nameKey":"office","icon":"business","archived":false,"order":6000,"stage":"locations-06"} : id=="online" ? {"name":"Online","nameKey":"online","icon":"language","archived":false,"order":7000,"stage":"locations-07"} : id=="pharmacy" ? {"name":"Pharmacy","nameKey":"pharmacy","icon":"local_pharmacy","archived":false,"order":8000,"stage":"locations-08"} : id=="residence" ? {"name":"Residence","nameKey":"residence","icon":"home","archived":false,"order":9000,"stage":"locations-09"} : id=="school" ? {"name":"School","nameKey":"school","icon":"school","archived":false,"order":10000,"stage":"locations-10"} : {}) : {}; }
  function namedShape(d,x) { return d.keys().hasOnly(['schemaVersion','recordVersion','createdAt','updatedAt','name','nameKey','icon','archived','order']) && d.keys().hasAll(['schemaVersion','recordVersion','createdAt','updatedAt','name','nameKey','icon','archived','order']) && meta(d) && d.name==x.name && d.nameKey==x.nameKey && d.nameKey==d.name.lower() && d.icon==x.icon && d.archived==false && d.order==x.order; }
  function guardShape(d,key,id) { return d.keys().hasOnly(['schemaVersion','nameKey','entityId','createdAt']) && d.keys().hasAll(['schemaVersion','nameKey','entityId','createdAt']) && d.schemaVersion==1 && d.nameKey==key && d.entityId==id && d.createdAt==request.time; }
  function namedAfter(uid,kind,id) { let x=namedExpected(kind,id); return namedShape(getAfter(ep(uid,kind,id)).data,x) && guardShape(getAfter(gp(uid,kind,x.nameKey)).data,x.nameKey,id); }
  function viewExpected(id) { return id=="focus" ? {"name":"Focus","query":{"querySchemaVersion":1,"includeClosed":false,"includeDeleted":false,"filters":{},"groupBy":"due","sort":{"field":"due","direction":"asc"}},"showOnHome":true,"order":1000,"stage":"views-01"} : id=="scheduled" ? {"name":"Scheduled","query":{"querySchemaVersion":1,"includeClosed":false,"includeDeleted":false,"filters":{},"groupBy":"plannedStart","sort":{"field":"plannedStart","direction":"asc"}},"showOnHome":true,"order":2000,"stage":"views-02"} : id=="priority" ? {"name":"Priority","query":{"querySchemaVersion":1,"includeClosed":false,"includeDeleted":false,"filters":{},"groupBy":"importantUrgent","sort":{"field":"due","direction":"asc"}},"showOnHome":true,"order":3000,"stage":"views-03"} : id=="local" ? {"name":"Local","query":{"querySchemaVersion":1,"includeClosed":false,"includeDeleted":false,"filters":{},"groupBy":"location","sort":{"field":"due","direction":"asc"}},"showOnHome":true,"order":4000,"stage":"views-04"} : id=="completed" ? {"name":"Completed","query":{"querySchemaVersion":1,"includeClosed":true,"includeDeleted":false,"filters":{"lifecycle":{"op":"in","values":["closed"]},"closureOutcome":{"op":"in","values":["done"]}},"groupBy":"actualEnd","sort":{"field":"actualEnd","direction":"desc"}},"showOnHome":true,"order":5000,"stage":"views-05"} : id=="deleted" ? {"name":"Deleted","query":{"querySchemaVersion":1,"includeClosed":true,"includeDeleted":true,"filters":{"deletedAt":[{"op":"isSet"}]},"groupBy":"deletedAt","sort":{"field":"deletedAt","direction":"desc"}},"showOnHome":true,"order":6000,"stage":"views-06"} : id=="all-tasks" ? {"name":"All Tasks","query":{"querySchemaVersion":1,"includeClosed":false,"includeDeleted":false,"filters":{},"groupBy":"category","sort":{"field":"due","direction":"asc"}},"showOnHome":true,"order":7000,"stage":"views-07"} : {}; }
  function viewShape(d,x) { return d.keys().hasOnly(['schemaVersion','recordVersion','createdAt','updatedAt','name','query','showOnHome','order']) && d.keys().hasAll(['schemaVersion','recordVersion','createdAt','updatedAt','name','query','showOnHome','order']) && meta(d) && d.name==x.name && d.query==x.query && d.showOnHome==true && d.order==x.order; }
  function baseAfter(uid) { let i=getAfter(ip(uid)).data; let p=getAfter(ep(uid,'profile','main')).data; let s=getAfter(ep(uid,'settings','main')).data;
   return i.keys().hasOnly(['schemaVersion','recordVersion','createdAt','updatedAt','templateVersion','status']) && i.keys().hasAll(['schemaVersion','recordVersion','createdAt','updatedAt','templateVersion','status']) && meta(i) && i.templateVersion==1 && i.status=='initializing' &&
    p.keys().hasOnly(['schemaVersion','recordVersion','createdAt','updatedAt']) && p.keys().hasAll(['schemaVersion','recordVersion','createdAt','updatedAt']) && meta(p) &&
    s.keys().hasOnly(['schemaVersion','recordVersion','createdAt','updatedAt','timezone']) && s.keys().hasAll(['schemaVersion','recordVersion','createdAt','updatedAt','timezone']) && meta(s) && s.timezone=='UTC'; }
  function stageContents(uid,stage) { return stage=='base' ? baseAfter(uid) : stage=='categories-01' ? (namedAfter(uid,'categories','family') && namedAfter(uid,'categories','finance')) : stage=='categories-02' ? (namedAfter(uid,'categories','friends') && namedAfter(uid,'categories','growth')) : stage=='categories-03' ? (namedAfter(uid,'categories','hobbies') && namedAfter(uid,'categories','household')) : stage=='categories-04' ? (namedAfter(uid,'categories','leisure') && namedAfter(uid,'categories','self')) : stage=='categories-05' ? (namedAfter(uid,'categories','social') && namedAfter(uid,'categories','wellness')) : stage=='categories-06' ? (namedAfter(uid,'categories','work') && namedAfter(uid,'categories','uncategorized')) : stage=='locations-01' ? (namedAfter(uid,'locations','grocery')) : stage=='locations-02' ? (namedAfter(uid,'locations','gym')) : stage=='locations-03' ? (namedAfter(uid,'locations','local-stores')) : stage=='locations-04' ? (namedAfter(uid,'locations','mall')) : stage=='locations-05' ? (namedAfter(uid,'locations','market')) : stage=='locations-06' ? (namedAfter(uid,'locations','office')) : stage=='locations-07' ? (namedAfter(uid,'locations','online')) : stage=='locations-08' ? (namedAfter(uid,'locations','pharmacy')) : stage=='locations-09' ? (namedAfter(uid,'locations','residence')) : stage=='locations-10' ? (namedAfter(uid,'locations','school')) : stage=='views-01' ? (viewShape(getAfter(ep(uid,'views','focus')).data,viewExpected('focus'))) : stage=='views-02' ? (viewShape(getAfter(ep(uid,'views','scheduled')).data,viewExpected('scheduled'))) : stage=='views-03' ? (viewShape(getAfter(ep(uid,'views','priority')).data,viewExpected('priority'))) : stage=='views-04' ? (viewShape(getAfter(ep(uid,'views','local')).data,viewExpected('local'))) : stage=='views-05' ? (viewShape(getAfter(ep(uid,'views','completed')).data,viewExpected('completed'))) : stage=='views-06' ? (viewShape(getAfter(ep(uid,'views','deleted')).data,viewExpected('deleted'))) : stage=='views-07' ? (viewShape(getAfter(ep(uid,'views','all-tasks')).data,viewExpected('all-tasks'))) : false; }
  match /runtime/compatibility { allow get: if true; allow list,write: if false; }
  match /accountDeletion/{uid} { allow get: if owner(uid); allow list,write: if false; }
  match /users/{uid}/{kind}/{id} {
   allow read: if owner(uid) && kind in ['profile','settings','initialization','initializationStages','categories','locations','views'];
   allow create: if unfenced(uid) && (
    (kind in ['profile','settings','initialization'] && allowed(kind=='profile'?'profile':kind=='settings'?'settings':'workspaceInitialization') && (kind=='initialization'?id=='workspace':id=='main') && receiptWritten(uid,'base') && baseAfter(uid)) ||
    (kind in ['categories','locations'] && allowed(kind=='categories'?'category':'location') && initializing(uid) && prerequisite(uid,namedExpected(kind,id).stage) && receiptWritten(uid,namedExpected(kind,id).stage) && namedAfter(uid,kind,id)) ||
    (kind=='views' && allowed('view') && initializing(uid) && prerequisite(uid,viewExpected(id).stage) && receiptWritten(uid,viewExpected(id).stage) && viewShape(request.resource.data,viewExpected(id))) ||
    (kind=='initializationStages' && allowed('initializationStage') && receiptShape(request.resource.data) && prerequisite(uid,id) && stageContents(uid,id))
   );
   allow update: if kind=='initialization' && id=='workspace' && unfenced(uid) && allowed('workspaceInitialization') && resource.data.status=='initializing' && resource.data.recordVersion==1 && exists(rp(uid,'views-07')) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','recordVersion','updatedAt','completedAt']) && request.resource.data.status=='complete' && request.resource.data.recordVersion==2 && request.resource.data.updatedAt==request.time && request.resource.data.completedAt==request.time;
   allow delete: if false;
  }
  match /users/{uid}/nameKeys/{kind}/keys/{digest} {
   allow read: if owner(uid) && kind in ['categories','locations'];
   allow create: if unfenced(uid) && allowed('nameReservation') && kind in ['categories','locations'] && initializing(uid) &&
    digest==hashing.sha256(request.resource.data.nameKey).toHexString().lower() &&
    guardShape(request.resource.data,request.resource.data.nameKey,request.resource.data.entityId) &&
    prerequisite(uid,namedExpected(kind,request.resource.data.entityId).stage) && receiptWritten(uid,namedExpected(kind,request.resource.data.entityId).stage) &&
    namedAfter(uid,kind,request.resource.data.entityId);
   allow update,delete: if false;
  }
  match /{document=**} { allow read,write: if false; }
 }
}
