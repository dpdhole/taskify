// Generated Slice5 initialization policy. Run npm run generate:workspace-rules.
// Owner reads and exact template1 provisioning only; management/deletion-request writes denied.
// No deployment is performed by generation or local tests.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function ep(uid,kind,id) { return /databases/$(database)/documents/users/$(uid)/$(kind)/$(id); }
  function ip(uid) { return /databases/$(database)/documents/users/$(uid)/initialization/workspace; }
  function rp(uid,stage) { return /databases/$(database)/documents/users/$(uid)/initializationStages/$(stage); }
  function gp(uid,kind,key) { let digest=hashing.sha256(key).toHexString().lower(); return /databases/$(database)/documents/users/$(uid)/nameKeys/$(kind)/keys/$(digest); }
  function owner(uid) { return request.auth != null &&
      request.auth.uid == uid; }
  function unfenced(uid) { return owner(uid) &&
      !exists(/databases/$(database)/documents/accountDeletion/$(uid)); }
  function allowed(family) {
    let c=get(/databases/$(database)/documents/runtime/compatibility).data;
    return c.contractFormatVersion==1 &&
      c.environmentId==request.auth.token.aud &&
      c.revision is int &&
      c.revision>0 &&
      c.serverRelease is int &&
      c.serverRelease>0 &&
      c.recordFamilies[family].presentSchemaVersions.hasAny([1]) &&
      c.recordFamilies[family].allowedWriteSchemaVersions.hasAny([1]);
  }
  function meta(d) { return d.schemaVersion==1 &&
      d.recordVersion==1 &&
      d.createdAt==request.time &&
      d.updatedAt==request.time; }
  function initializing(uid) { let i=get(ip(uid)).data; return i.schemaVersion==1 &&
      i.templateVersion==1 &&
      i.status=='initializing'; }
  function previous(stage) { return {"base":"","categories-01":"base","categories-02":"categories-01","categories-03":"categories-02","categories-04":"categories-03","categories-05":"categories-04","categories-06":"categories-05","locations-01":"categories-06","locations-02":"locations-01","locations-03":"locations-02","locations-04":"locations-03","locations-05":"locations-04","locations-06":"locations-05","locations-07":"locations-06","locations-08":"locations-07","locations-09":"locations-08","locations-10":"locations-09","views-01":"locations-10","views-02":"views-01","views-03":"views-02","views-04":"views-03","views-05":"views-04","views-06":"views-05","views-07":"views-06"}[stage]; }
  function prerequisite(uid,stage) { return stage=='base' ? !exists(ip(uid)) : initializing(uid) &&
      exists(rp(uid,previous(stage))); }
  function receiptShape(d) { return d.keys().hasOnly(['schemaVersion','templateVersion','completedAt']) &&
      d.keys().hasAll(['schemaVersion','templateVersion','completedAt']) &&
      d.schemaVersion==1 &&
      d.templateVersion==1 &&
      d.completedAt==request.time; }
  function receiptWritten(uid,stage) { return !exists(rp(uid,stage)) &&
      receiptShape(getAfter(rp(uid,stage)).data); }
  function namedExpected(kind,id) { return kind=="categories" ? (id=="family" ? {"name":"Family","nameKey":"family","icon":"family_restroom","archived":false,"order":1000,"stage":"categories-01"} :
      id=="finance" ? {"name":"Finance","nameKey":"finance","icon":"wallet","archived":false,"order":2000,"stage":"categories-01"} :
      id=="friends" ? {"name":"Friends","nameKey":"friends","icon":"group","archived":false,"order":3000,"stage":"categories-02"} :
      id=="growth" ? {"name":"Growth","nameKey":"growth","icon":"trending_up","archived":false,"order":4000,"stage":"categories-02"} :
      id=="hobbies" ? {"name":"Hobbies","nameKey":"hobbies","icon":"palette","archived":false,"order":5000,"stage":"categories-03"} :
      id=="household" ? {"name":"Household","nameKey":"household","icon":"home_and_garden","archived":false,"order":6000,"stage":"categories-03"} :
      id=="leisure" ? {"name":"Leisure","nameKey":"leisure","icon":"weekend","archived":false,"order":7000,"stage":"categories-04"} :
      id=="self" ? {"name":"Self","nameKey":"self","icon":"person","archived":false,"order":8000,"stage":"categories-04"} :
      id=="social" ? {"name":"Social","nameKey":"social","icon":"celebration","archived":false,"order":9000,"stage":"categories-05"} :
      id=="wellness" ? {"name":"Wellness","nameKey":"wellness","icon":"heart_plus","archived":false,"order":10000,"stage":"categories-05"} :
      id=="work" ? {"name":"Work","nameKey":"work","icon":"work","archived":false,"order":11000,"stage":"categories-06"} :
      id=="uncategorized" ? {"name":"Uncategorized","nameKey":"uncategorized","icon":"category","archived":false,"order":12000,"stage":"categories-06"} : {}) : kind=="locations" ? (id=="grocery" ? {"name":"Grocery","nameKey":"grocery","icon":"local_grocery_store","archived":false,"order":1000,"stage":"locations-01"} :
      id=="gym" ? {"name":"Gym","nameKey":"gym","icon":"fitness_center","archived":false,"order":2000,"stage":"locations-02"} :
      id=="local-stores" ? {"name":"Local Stores","nameKey":"local stores","icon":"storefront","archived":false,"order":3000,"stage":"locations-03"} :
      id=="mall" ? {"name":"Mall","nameKey":"mall","icon":"local_mall","archived":false,"order":4000,"stage":"locations-04"} :
      id=="market" ? {"name":"Market","nameKey":"market","icon":"store","archived":false,"order":5000,"stage":"locations-05"} :
      id=="office" ? {"name":"Office","nameKey":"office","icon":"business","archived":false,"order":6000,"stage":"locations-06"} :
      id=="online" ? {"name":"Online","nameKey":"online","icon":"language","archived":false,"order":7000,"stage":"locations-07"} :
      id=="pharmacy" ? {"name":"Pharmacy","nameKey":"pharmacy","icon":"local_pharmacy","archived":false,"order":8000,"stage":"locations-08"} :
      id=="residence" ? {"name":"Residence","nameKey":"residence","icon":"home","archived":false,"order":9000,"stage":"locations-09"} :
      id=="school" ? {"name":"School","nameKey":"school","icon":"school","archived":false,"order":10000,"stage":"locations-10"} : {}) : {}; }
  function namedShape(d,x) { return d.keys().hasOnly(['schemaVersion','recordVersion','createdAt','updatedAt','name','nameKey','icon','archived','order']) &&
      d.keys().hasAll(['schemaVersion','recordVersion','createdAt','updatedAt','name','nameKey','icon','archived','order']) &&
      meta(d) &&
      d.name==x.name &&
      d.nameKey==x.nameKey &&
      d.nameKey==d.name.lower() &&
      d.icon==x.icon &&
      d.archived==false &&
      d.order==x.order; }
  function guardShape(d,key,id) { return d.keys().hasOnly(['schemaVersion','nameKey','entityId','createdAt']) &&
      d.keys().hasAll(['schemaVersion','nameKey','entityId','createdAt']) &&
      d.schemaVersion==1 &&
      d.nameKey==key &&
      d.entityId==id &&
      d.createdAt==request.time; }
  function namedAfter(uid,kind,id) { let x=namedExpected(kind,id); return namedShape(getAfter(ep(uid,kind,id)).data,x) &&
      guardShape(getAfter(gp(uid,kind,x.nameKey)).data,x.nameKey,id); }
  function viewExpected(id) { return id=="focus" ? {"name":"Focus","query":{"querySchemaVersion":1,"includeClosed":false,"includeDeleted":false,"filters":{},"groupBy":"due","sort":{"field":"due","direction":"asc"}},"showOnHome":true,"order":1000,"stage":"views-01"} :
      id=="scheduled" ? {"name":"Scheduled","query":{"querySchemaVersion":1,"includeClosed":false,"includeDeleted":false,"filters":{},"groupBy":"plannedStart","sort":{"field":"plannedStart","direction":"asc"}},"showOnHome":true,"order":2000,"stage":"views-02"} :
      id=="priority" ? {"name":"Priority","query":{"querySchemaVersion":1,"includeClosed":false,"includeDeleted":false,"filters":{},"groupBy":"importantUrgent","sort":{"field":"due","direction":"asc"}},"showOnHome":true,"order":3000,"stage":"views-03"} :
      id=="local" ? {"name":"Local","query":{"querySchemaVersion":1,"includeClosed":false,"includeDeleted":false,"filters":{},"groupBy":"location","sort":{"field":"due","direction":"asc"}},"showOnHome":true,"order":4000,"stage":"views-04"} :
      id=="completed" ? {"name":"Completed","query":{"querySchemaVersion":1,"includeClosed":true,"includeDeleted":false,"filters":{"lifecycle":{"op":"in","values":["closed"]},"closureOutcome":{"op":"in","values":["done"]}},"groupBy":"actualEnd","sort":{"field":"actualEnd","direction":"desc"}},"showOnHome":true,"order":5000,"stage":"views-05"} :
      id=="deleted" ? {"name":"Deleted","query":{"querySchemaVersion":1,"includeClosed":true,"includeDeleted":true,"filters":{"deletedAt":[{"op":"isSet"}]},"groupBy":"deletedAt","sort":{"field":"deletedAt","direction":"desc"}},"showOnHome":true,"order":6000,"stage":"views-06"} :
      id=="all-tasks" ? {"name":"All Tasks","query":{"querySchemaVersion":1,"includeClosed":false,"includeDeleted":false,"filters":{},"groupBy":"category","sort":{"field":"due","direction":"asc"}},"showOnHome":true,"order":7000,"stage":"views-07"} : {}; }
  function viewShape(d,x) { return d.keys().hasOnly(['schemaVersion','recordVersion','createdAt','updatedAt','name','query','showOnHome','order']) &&
      d.keys().hasAll(['schemaVersion','recordVersion','createdAt','updatedAt','name','query','showOnHome','order']) &&
      meta(d) &&
      d.name==x.name &&
      d.query==x.query &&
      d.showOnHome==true &&
      d.order==x.order; }
  function profileShape(p) {
    return p.keys().hasOnly(['schemaVersion','recordVersion','createdAt','updatedAt','displayName','photoUrl']) &&
      p.keys().hasAll(['schemaVersion','recordVersion','createdAt','updatedAt']) &&
      meta(p) &&
      (!('displayName' in p) || (p.displayName is string &&
      p.displayName.size()>0 &&
      p.displayName==p.displayName.trim() &&
      p.displayName.toUtf8().size()<=1024)) &&
      (!('photoUrl' in p) || (p.photoUrl is string &&
      p.photoUrl.toUtf8().size()<=8192 &&
      p.photoUrl.matches("^https://[^\\s/?#@]+(?:[/?#][^\\s]*)?$")));
  }
  function validTimezone(value) { return value is string &&
      (value.matches("^(?:Africa/Abidjan|Africa/Accra|Africa/Addis_Ababa|Africa/Algiers|Africa/Asmara|Africa/Asmera|Africa/Bamako|Africa/Bangui|Africa/Banjul|Africa/Bissau|Africa/Blantyre|Africa/Brazzaville|Africa/Bujumbura|Africa/Cairo|Africa/Casablanca|Africa/Ceuta|Africa/Conakry|Africa/Dakar|Africa/Dar_es_Salaam|Africa/Djibouti|Africa/Douala|Africa/El_Aaiun|Africa/Freetown|Africa/Gaborone|Africa/Harare|Africa/Johannesburg|Africa/Juba|Africa/Kampala|Africa/Khartoum|Africa/Kigali|Africa/Kinshasa|Africa/Lagos|Africa/Libreville|Africa/Lome|Africa/Luanda|Africa/Lubumbashi|Africa/Lusaka|Africa/Malabo|Africa/Maputo|Africa/Maseru|Africa/Mbabane|Africa/Mogadishu|Africa/Monrovia|Africa/Nairobi|Africa/Ndjamena|Africa/Niamey|Africa/Nouakchott|Africa/Ouagadougou|Africa/Porto-Novo|Africa/Sao_Tome|Africa/Timbuktu|Africa/Tripoli|Africa/Tunis|Africa/Windhoek|America/Adak|America/Anchorage|America/Anguilla|America/Antigua|America/Araguaina|America/Argentina/Buenos_Aires|America/Argentina/Catamarca|America/Argentina/ComodRivadavia|America/Argentina/Cordoba|America/Argentina/Jujuy|America/Argentina/La_Rioja|America/Argentina/Mendoza|America/Argentina/Rio_Gallegos|America/Argentina/Salta|America/Argentina/San_Juan|America/Argentina/San_Luis|America/Argentina/Tucuman|America/Argentina/Ushuaia|America/Aruba|America/Asuncion|America/Atikokan|America/Atka|America/Bahia|America/Bahia_Banderas|America/Barbados|America/Belem|America/Belize|America/Blanc-Sablon|America/Boa_Vista|America/Bogota|America/Boise|America/Buenos_Aires|America/Cambridge_Bay|America/Campo_Grande|America/Cancun|America/Caracas|America/Catamarca|America/Cayenne|America/Cayman|America/Chicago|America/Chihuahua|America/Ciudad_Juarez|America/Coral_Harbour|America/Cordoba|America/Costa_Rica|America/Coyhaique|America/Creston|America/Cuiaba|America/Curacao|America/Danmarkshavn|America/Dawson|America/Dawson_Creek|America/Denver|America/Detroit|America/Dominica|America/Edmonton|America/Eirunepe|America/El_Salvador|America/Ensenada|America/Fort_Nelson|America/Fort_Wayne|America/Fortaleza|America/Glace_Bay|America/Godthab|America/Goose_Bay|America/Grand_Turk|America/Grenada|America/Guadeloupe|America/Guatemala|America/Guayaquil|America/Guyana|America/Halifax|America/Havana|America/Hermosillo|America/Indiana/Indianapolis|America/Indiana/Knox|America/Indiana/Marengo|America/Indiana/Petersburg|America/Indiana/Tell_City|America/Indiana/Vevay|America/Indiana/Vincennes|America/Indiana/Winamac|America/Indianapolis|America/Inuvik|America/Iqaluit|America/Jamaica|America/Jujuy|America/Juneau|America/Kentucky/Louisville|America/Kentucky/Monticello|America/Knox_IN|America/Kralendijk|America/La_Paz|America/Lima|America/Los_Angeles|America/Louisville|America/Lower_Princes|America/Maceio|America/Managua|America/Manaus|America/Marigot|America/Martinique|America/Matamoros|America/Mazatlan|America/Mendoza|America/Menominee|America/Merida|America/Metlakatla|America/Mexico_City|America/Miquelon|America/Moncton|America/Monterrey|America/Montevideo)$") || value.matches("^(?:America/Montreal|America/Montserrat|America/Nassau|America/New_York|America/Nipigon|America/Nome|America/Noronha|America/North_Dakota/Beulah|America/North_Dakota/Center|America/North_Dakota/New_Salem|America/Nuuk|America/Ojinaga|America/Panama|America/Pangnirtung|America/Paramaribo|America/Phoenix|America/Port-au-Prince|America/Port_of_Spain|America/Porto_Acre|America/Porto_Velho|America/Puerto_Rico|America/Punta_Arenas|America/Rainy_River|America/Rankin_Inlet|America/Recife|America/Regina|America/Resolute|America/Rio_Branco|America/Rosario|America/Santa_Isabel|America/Santarem|America/Santiago|America/Santo_Domingo|America/Sao_Paulo|America/Scoresbysund|America/Shiprock|America/Sitka|America/St_Barthelemy|America/St_Johns|America/St_Kitts|America/St_Lucia|America/St_Thomas|America/St_Vincent|America/Swift_Current|America/Tegucigalpa|America/Thule|America/Thunder_Bay|America/Tijuana|America/Toronto|America/Tortola|America/Vancouver|America/Virgin|America/Whitehorse|America/Winnipeg|America/Yakutat|America/Yellowknife|Antarctica/Casey|Antarctica/Davis|Antarctica/DumontDUrville|Antarctica/Macquarie|Antarctica/Mawson|Antarctica/McMurdo|Antarctica/Palmer|Antarctica/Rothera|Antarctica/South_Pole|Antarctica/Syowa|Antarctica/Troll|Antarctica/Vostok|Arctic/Longyearbyen|Asia/Aden|Asia/Almaty|Asia/Amman|Asia/Anadyr|Asia/Aqtau|Asia/Aqtobe|Asia/Ashgabat|Asia/Ashkhabad|Asia/Atyrau|Asia/Baghdad|Asia/Bahrain|Asia/Baku|Asia/Bangkok|Asia/Barnaul|Asia/Beirut|Asia/Bishkek|Asia/Brunei|Asia/Calcutta|Asia/Chita|Asia/Choibalsan|Asia/Chongqing|Asia/Chungking|Asia/Colombo|Asia/Dacca|Asia/Damascus|Asia/Dhaka|Asia/Dili|Asia/Dubai|Asia/Dushanbe|Asia/Famagusta|Asia/Gaza|Asia/Harbin|Asia/Hebron|Asia/Ho_Chi_Minh|Asia/Hong_Kong|Asia/Hovd|Asia/Irkutsk|Asia/Istanbul|Asia/Jakarta|Asia/Jayapura|Asia/Jerusalem|Asia/Kabul|Asia/Kamchatka|Asia/Karachi|Asia/Kashgar|Asia/Kathmandu|Asia/Katmandu|Asia/Khandyga|Asia/Kolkata|Asia/Krasnoyarsk|Asia/Kuala_Lumpur|Asia/Kuching|Asia/Kuwait|Asia/Macao|Asia/Macau|Asia/Magadan|Asia/Makassar|Asia/Manila|Asia/Muscat|Asia/Nicosia|Asia/Novokuznetsk|Asia/Novosibirsk|Asia/Omsk|Asia/Oral|Asia/Phnom_Penh|Asia/Pontianak|Asia/Pyongyang|Asia/Qatar|Asia/Qostanay|Asia/Qyzylorda|Asia/Rangoon|Asia/Riyadh|Asia/Saigon|Asia/Sakhalin|Asia/Samarkand|Asia/Seoul|Asia/Shanghai|Asia/Singapore|Asia/Srednekolymsk|Asia/Taipei|Asia/Tashkent|Asia/Tbilisi|Asia/Tehran|Asia/Tel_Aviv|Asia/Thimbu|Asia/Thimphu|Asia/Tokyo|Asia/Tomsk|Asia/Ujung_Pandang|Asia/Ulaanbaatar|Asia/Ulan_Bator|Asia/Urumqi|Asia/Ust-Nera|Asia/Vientiane|Asia/Vladivostok|Asia/Yakutsk|Asia/Yangon|Asia/Yekaterinburg|Asia/Yerevan|Atlantic/Azores|Atlantic/Bermuda|Atlantic/Canary|Atlantic/Cape_Verde|Atlantic/Faeroe|Atlantic/Faroe|Atlantic/Jan_Mayen|Atlantic/Madeira|Atlantic/Reykjavik|Atlantic/South_Georgia|Atlantic/St_Helena|Atlantic/Stanley|Australia/ACT|Australia/Adelaide|Australia/Brisbane|Australia/Broken_Hill|Australia/Canberra|Australia/Currie|Australia/Darwin|Australia/Eucla|Australia/Hobart|Australia/LHI)$") || value.matches("^(?:Australia/Lindeman|Australia/Lord_Howe|Australia/Melbourne|Australia/NSW|Australia/North|Australia/Perth|Australia/Queensland|Australia/South|Australia/Sydney|Australia/Tasmania|Australia/Victoria|Australia/West|Australia/Yancowinna|Brazil/Acre|Brazil/DeNoronha|Brazil/East|Brazil/West|CET|CST6CDT|Canada/Atlantic|Canada/Central|Canada/Eastern|Canada/Mountain|Canada/Newfoundland|Canada/Pacific|Canada/Saskatchewan|Canada/Yukon|Chile/Continental|Chile/EasterIsland|Cuba|EET|EST|EST5EDT|Egypt|Eire|Etc/GMT|Etc/GMT\\+0|Etc/GMT\\+1|Etc/GMT\\+10|Etc/GMT\\+11|Etc/GMT\\+12|Etc/GMT\\+2|Etc/GMT\\+3|Etc/GMT\\+4|Etc/GMT\\+5|Etc/GMT\\+6|Etc/GMT\\+7|Etc/GMT\\+8|Etc/GMT\\+9|Etc/GMT-0|Etc/GMT-1|Etc/GMT-10|Etc/GMT-11|Etc/GMT-12|Etc/GMT-13|Etc/GMT-14|Etc/GMT-2|Etc/GMT-3|Etc/GMT-4|Etc/GMT-5|Etc/GMT-6|Etc/GMT-7|Etc/GMT-8|Etc/GMT-9|Etc/GMT0|Etc/Greenwich|Etc/UCT|Etc/UTC|Etc/Universal|Etc/Zulu|Europe/Amsterdam|Europe/Andorra|Europe/Astrakhan|Europe/Athens|Europe/Belfast|Europe/Belgrade|Europe/Berlin|Europe/Bratislava|Europe/Brussels|Europe/Bucharest|Europe/Budapest|Europe/Busingen|Europe/Chisinau|Europe/Copenhagen|Europe/Dublin|Europe/Gibraltar|Europe/Guernsey|Europe/Helsinki|Europe/Isle_of_Man|Europe/Istanbul|Europe/Jersey|Europe/Kaliningrad|Europe/Kiev|Europe/Kirov|Europe/Kyiv|Europe/Lisbon|Europe/Ljubljana|Europe/London|Europe/Luxembourg|Europe/Madrid|Europe/Malta|Europe/Mariehamn|Europe/Minsk|Europe/Monaco|Europe/Moscow|Europe/Nicosia|Europe/Oslo|Europe/Paris|Europe/Podgorica|Europe/Prague|Europe/Riga|Europe/Rome|Europe/Samara|Europe/San_Marino|Europe/Sarajevo|Europe/Saratov|Europe/Simferopol|Europe/Skopje|Europe/Sofia|Europe/Stockholm|Europe/Tallinn|Europe/Tirane|Europe/Tiraspol|Europe/Ulyanovsk|Europe/Uzhgorod|Europe/Vaduz|Europe/Vatican|Europe/Vienna|Europe/Vilnius|Europe/Volgograd|Europe/Warsaw|Europe/Zagreb|Europe/Zaporozhye|Europe/Zurich|GB|GB-Eire|GMT|GMT\\+0|GMT-0|GMT0|Greenwich|HST|Hongkong|Iceland|Indian/Antananarivo|Indian/Chagos|Indian/Christmas|Indian/Cocos|Indian/Comoro|Indian/Kerguelen|Indian/Mahe|Indian/Maldives|Indian/Mauritius|Indian/Mayotte|Indian/Reunion|Iran|Israel|Jamaica|Japan|Kwajalein|Libya|MET|MST|MST7MDT|Mexico/BajaNorte|Mexico/BajaSur|Mexico/General|NZ|NZ-CHAT|Navajo|PRC|PST8PDT|Pacific/Apia|Pacific/Auckland|Pacific/Bougainville|Pacific/Chatham|Pacific/Chuuk|Pacific/Easter|Pacific/Efate|Pacific/Enderbury|Pacific/Fakaofo|Pacific/Fiji|Pacific/Funafuti|Pacific/Galapagos|Pacific/Gambier|Pacific/Guadalcanal|Pacific/Guam|Pacific/Honolulu|Pacific/Johnston|Pacific/Kanton|Pacific/Kiritimati|Pacific/Kosrae|Pacific/Kwajalein|Pacific/Majuro|Pacific/Marquesas|Pacific/Midway|Pacific/Nauru|Pacific/Niue|Pacific/Norfolk|Pacific/Noumea|Pacific/Pago_Pago|Pacific/Palau|Pacific/Pitcairn|Pacific/Pohnpei|Pacific/Ponape|Pacific/Port_Moresby|Pacific/Rarotonga|Pacific/Saipan|Pacific/Samoa|Pacific/Tahiti|Pacific/Tarawa|Pacific/Tongatapu|Pacific/Truk|Pacific/Wake|Pacific/Wallis|Pacific/Yap|Poland|Portugal|ROC|ROK|Singapore|Turkey|UCT|US/Alaska|US/Aleutian|US/Arizona|US/Central)$") || value.matches("^(?:US/East-Indiana|US/Eastern|US/Hawaii|US/Indiana-Starke|US/Michigan|US/Mountain|US/Pacific|US/Samoa|UTC|Universal|W-SU|WET|Zulu)$")); }
  function baseAfter(uid) { let i=getAfter(ip(uid)).data; let p=getAfter(ep(uid,'profile','main')).data; let s=getAfter(ep(uid,'settings','main')).data;
   return i.keys().hasOnly(['schemaVersion','recordVersion','createdAt','updatedAt','templateVersion','status']) &&
      i.keys().hasAll(['schemaVersion','recordVersion','createdAt','updatedAt','templateVersion','status']) &&
      meta(i) &&
      i.templateVersion==1 &&
      i.status=='initializing' &&
    profileShape(p) &&
    s.keys().hasOnly(['schemaVersion','recordVersion','createdAt','updatedAt','timezone']) &&
      s.keys().hasAll(['schemaVersion','recordVersion','createdAt','updatedAt','timezone']) &&
      meta(s) &&
      validTimezone(s.timezone); }
  function stageContents(uid,stage) { return stage=='base' ? baseAfter(uid) :
      stage=='categories-01' ? (namedAfter(uid,'categories','family') &&
      namedAfter(uid,'categories','finance')) :
      stage=='categories-02' ? (namedAfter(uid,'categories','friends') &&
      namedAfter(uid,'categories','growth')) :
      stage=='categories-03' ? (namedAfter(uid,'categories','hobbies') &&
      namedAfter(uid,'categories','household')) :
      stage=='categories-04' ? (namedAfter(uid,'categories','leisure') &&
      namedAfter(uid,'categories','self')) :
      stage=='categories-05' ? (namedAfter(uid,'categories','social') &&
      namedAfter(uid,'categories','wellness')) :
      stage=='categories-06' ? (namedAfter(uid,'categories','work') &&
      namedAfter(uid,'categories','uncategorized')) :
      stage=='locations-01' ? (namedAfter(uid,'locations','grocery')) :
      stage=='locations-02' ? (namedAfter(uid,'locations','gym')) :
      stage=='locations-03' ? (namedAfter(uid,'locations','local-stores')) :
      stage=='locations-04' ? (namedAfter(uid,'locations','mall')) :
      stage=='locations-05' ? (namedAfter(uid,'locations','market')) :
      stage=='locations-06' ? (namedAfter(uid,'locations','office')) :
      stage=='locations-07' ? (namedAfter(uid,'locations','online')) :
      stage=='locations-08' ? (namedAfter(uid,'locations','pharmacy')) :
      stage=='locations-09' ? (namedAfter(uid,'locations','residence')) :
      stage=='locations-10' ? (namedAfter(uid,'locations','school')) :
      stage=='views-01' ? (viewShape(getAfter(ep(uid,'views','focus')).data,viewExpected('focus'))) :
      stage=='views-02' ? (viewShape(getAfter(ep(uid,'views','scheduled')).data,viewExpected('scheduled'))) :
      stage=='views-03' ? (viewShape(getAfter(ep(uid,'views','priority')).data,viewExpected('priority'))) :
      stage=='views-04' ? (viewShape(getAfter(ep(uid,'views','local')).data,viewExpected('local'))) :
      stage=='views-05' ? (viewShape(getAfter(ep(uid,'views','completed')).data,viewExpected('completed'))) :
      stage=='views-06' ? (viewShape(getAfter(ep(uid,'views','deleted')).data,viewExpected('deleted'))) :
      stage=='views-07' ? (viewShape(getAfter(ep(uid,'views','all-tasks')).data,viewExpected('all-tasks'))) : false; }
  match /runtime/compatibility { allow get: if true; allow list,write: if false; }
  match /accountDeletion/{uid} { allow get: if owner(uid); allow list,write: if false; }
  match /users/{uid}/{kind}/{id} {
   allow read: if unfenced(uid) &&
      kind in ['profile','settings','initialization','initializationStages','categories','locations','views'];
   allow create: if unfenced(uid) &&
      (
    (kind in ['profile','settings','initialization'] &&
      allowed(kind=='profile'?'profile':kind=='settings'?'settings':'workspaceInitialization') &&
      (kind=='initialization'?id=='workspace':id=='main') &&
      receiptWritten(uid,'base') &&
      baseAfter(uid)) ||
    (kind in ['categories','locations'] &&
      allowed(kind=='categories'?'category':'location') &&
      initializing(uid) &&
      prerequisite(uid,namedExpected(kind,id).stage) &&
      receiptWritten(uid,namedExpected(kind,id).stage) &&
      namedAfter(uid,kind,id)) ||
    (kind=='views' &&
      allowed('view') &&
      initializing(uid) &&
      prerequisite(uid,viewExpected(id).stage) &&
      receiptWritten(uid,viewExpected(id).stage) &&
      viewShape(request.resource.data,viewExpected(id))) ||
    (kind=='initializationStages' &&
      allowed('initializationStage') &&
      receiptShape(request.resource.data) &&
      prerequisite(uid,id) &&
      stageContents(uid,id))
   );
   allow update: if kind=='initialization' &&
      id=='workspace' &&
      unfenced(uid) &&
      allowed('workspaceInitialization') &&
      resource.data.status=='initializing' &&
      resource.data.recordVersion==1 &&
      exists(rp(uid,'views-07')) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','recordVersion','updatedAt','completedAt']) &&
      request.resource.data.status=='complete' &&
      request.resource.data.recordVersion==2 &&
      request.resource.data.updatedAt==request.time &&
      request.resource.data.completedAt==request.time;
   allow delete: if false;
  }
  match /users/{uid}/nameKeys/{kind}/keys/{digest} {
   allow read: if unfenced(uid) &&
      kind in ['categories','locations'];
   allow create: if unfenced(uid) &&
      allowed('nameReservation') &&
      kind in ['categories','locations'] &&
      initializing(uid) &&
    digest==hashing.sha256(request.resource.data.nameKey).toHexString().lower() &&
    guardShape(request.resource.data,request.resource.data.nameKey,request.resource.data.entityId) &&
    prerequisite(uid,namedExpected(kind,request.resource.data.entityId).stage) &&
      receiptWritten(uid,namedExpected(kind,request.resource.data.entityId).stage) &&
    namedAfter(uid,kind,request.resource.data.entityId);
   allow update,delete: if false;
  }
  match /{document=**} { allow read,write: if false; }
 }
}
