{
  "name": "taskify",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zustand": "5.0.16",
    "firebase": "13.1.0"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "firebase-tools": "15.34.1",
    "@firebase/rules-unit-testing": "6.0.0"
  },
  "type": "module",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --strictPort",
    "dev:proof": "node node_modules/vite/bin/vite.js --mode foundation --host 127.0.0.1 --strictPort",
    "build": "node node_modules/vite/bin/vite.js build",
    "build:proof": "node node_modules/vite/bin/vite.js build --mode foundation",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --strictPort",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "lint": "eslint src tests tools *.ts *.mjs",
    "format:check": "prettier --check src tests tools package.json tsconfig*.json *.ts *.mjs index.html foundation.html firebase.local.json .prettierrc.json",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run check:boundaries && npm run lint && npm run format:check && npm run test:unit && npm run build && npm run build:proof && node tools/check-bundles.mjs",
    "verify:all": "npm run verify && node tools/run-emulators.mjs",
    "setup:browsers": "node tools/install-browser.mjs"
  }
}
