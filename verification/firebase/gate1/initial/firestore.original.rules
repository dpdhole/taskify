rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function taskPath(uid, tid) { return /databases/$(database)/documents/users/$(uid)/tasks/$(tid); }
    function eventPath(uid, tid, eid) { return /databases/$(database)/documents/users/$(uid)/tasks/$(tid)/activityEvents/$(eid); }
    function taskFields() {
      return ['ownerUid','title','reference','lifecycle','pauseReason','pausedUntil',
        'plannedStart','due','actualStart','actualEnd','closureOutcome',
        'version','lastEventId','createdAt','updatedAt'];
    }
    function validShape(t) {
      return t.keys().hasOnly(taskFields()) && t.keys().hasAll(taskFields()) &&
        t.ownerUid is string && t.title is string && t.title.size() > 0 &&
        t.reference is string && t.reference.size() <= 255 &&
        t.version is int && t.version >= 0 && t.lastEventId is string &&
        t.createdAt is timestamp && t.updatedAt is timestamp &&
        t.lifecycle in ['Draft','InProgress','Closed'] &&
        (t.pauseReason == null || t.pauseReason in ['Waiting','Blocked','OnHold','Other']) &&
        (t.pausedUntil == null || t.pausedUntil is timestamp) &&
        (t.plannedStart == null || t.plannedStart is timestamp) &&
        (t.due == null || t.due is timestamp) &&
        (t.actualStart == null || t.actualStart is timestamp) &&
        (t.actualEnd == null || t.actualEnd is timestamp) &&
        (t.closureOutcome == null || t.closureOutcome in ['Done','Cancelled','UnableToComplete','NoLongerApplicable','Duplicate','Other']) &&
        (t.plannedStart == null || t.due == null || t.plannedStart <= t.due) &&
        ((t.lifecycle == 'Closed') == (t.closureOutcome != null && t.actualEnd != null)) &&
        (t.lifecycle != 'Closed' || (t.pauseReason == null && t.pausedUntil == null));
    }
    function changed(a,b) { return b.diff(a).affectedKeys(); }
    function onlyChanged(a,b,fields) { return changed(a,b).hasOnly(fields); }
    function validOp(op,a,b,comment) {
      return
        (op == 'Start' && a.lifecycle in ['Draft','InProgress'] &&
          a.actualStart == null && b.lifecycle == 'InProgress' &&
          b.actualStart == request.time && b.actualEnd == null &&
          ((b.pauseReason == a.pauseReason && b.pausedUntil == a.pausedUntil) ||
           (a.pauseReason != null && b.pauseReason == null && b.pausedUntil == null)) &&
          onlyChanged(a,b,['lifecycle','actualStart','pauseReason','pausedUntil','version','lastEventId','updatedAt'])) ||
        (op == 'Schedule' && a.lifecycle == 'Draft' && b.actualStart == null &&
          b.plannedStart != null &&
          ((b.lifecycle == 'InProgress' && b.pauseReason == null && b.pausedUntil == null) ||
           (b.lifecycle == 'Draft' && b.pauseReason == 'Waiting' &&
            b.pausedUntil == b.plannedStart && comment == 'Waiting to start')) &&
          onlyChanged(a,b,['lifecycle','plannedStart','due','pauseReason','pausedUntil','version','lastEventId','updatedAt'])) ||
        (op == 'Pause' && a.lifecycle != 'Closed' && a.pauseReason == null &&
          b.lifecycle == a.lifecycle && b.pauseReason != null &&
          comment.size() > 0 &&
          onlyChanged(a,b,['pauseReason','pausedUntil','version','lastEventId','updatedAt']) &&
          changed(a,b).hasAny(['pauseReason','pausedUntil'])) ||
        (op == 'EditPause' && a.lifecycle != 'Closed' && a.pauseReason != null &&
          b.lifecycle == a.lifecycle && b.pauseReason != null &&
          onlyChanged(a,b,['pauseReason','pausedUntil','version','lastEventId','updatedAt']) &&
          changed(a,b).hasAny(['pauseReason','pausedUntil'])) ||
        (op == 'Resume' && a.lifecycle != 'Closed' && a.pauseReason != null &&
          b.lifecycle in [a.lifecycle,'InProgress'] && b.pauseReason == null && b.pausedUntil == null &&
          ((b.lifecycle == a.lifecycle && b.actualStart == a.actualStart) ||
           (a.actualStart == null && b.actualStart == request.time && b.lifecycle == 'InProgress')) &&
          onlyChanged(a,b,['lifecycle','pauseReason','pausedUntil','actualStart','version','lastEventId','updatedAt'])) ||
        (op == 'Done' && a.lifecycle != 'Closed' && b.lifecycle == 'Closed' &&
          b.closureOutcome == 'Done' && b.actualEnd == request.time &&
          b.pauseReason == null && b.pausedUntil == null &&
          onlyChanged(a,b,['lifecycle','closureOutcome','actualEnd','pauseReason','pausedUntil','version','lastEventId','updatedAt'])) ||
        (op == 'Close' && a.lifecycle != 'Closed' && b.lifecycle == 'Closed' &&
          b.closureOutcome in ['Cancelled','UnableToComplete','NoLongerApplicable','Duplicate','Other'] &&
          b.actualEnd == request.time && b.pauseReason == null && b.pausedUntil == null &&
          onlyChanged(a,b,['lifecycle','closureOutcome','actualEnd','pauseReason','pausedUntil','version','lastEventId','updatedAt'])) ||
        (op == 'Reopen' && a.lifecycle == 'Closed' && b.lifecycle == 'InProgress' &&
          b.closureOutcome == null && b.actualEnd == null &&
          b.actualStart == a.actualStart &&
          onlyChanged(a,b,['lifecycle','closureOutcome','actualEnd','version','lastEventId','updatedAt'])) ||
        (op == 'EditDates' && a.lifecycle != 'Closed' &&
          onlyChanged(a,b,['plannedStart','due','version','lastEventId','updatedAt']) &&
          changed(a,b).hasAny(['plannedStart','due']));
    }
    function validAuditedUpdate(uid,tid) {
      let a = resource.data;
      let b = request.resource.data;
      let eid = b.lastEventId;
      let ep = eventPath(uid,tid,eid);
      let e = getAfter(ep).data;
      return validShape(b) && b.ownerUid == uid && b.createdAt == a.createdAt &&
        b.version == a.version + 1 && eid != a.lastEventId &&
        b.updatedAt == request.time && !exists(ep) &&
        e.ownerUid == uid && e.actorUid == uid && e.taskId == tid &&
        e.fromVersion == a.version && e.toVersion == b.version &&
        e.before == a && e.after == b && e.createdAt == request.time &&
        validOp(e.type,a,b,e.comment);
    }
    function validOrdinaryUpdate(uid) {
      let a = resource.data;
      let b = request.resource.data;
      return validShape(b) && b.ownerUid == uid && a.ownerUid == uid &&
        a.lifecycle != 'Closed' &&
        onlyChanged(a,b,['title','reference']) &&
        changed(a,b).hasAny(['title','reference']);
    }
    function validEventCreate(uid,tid,eid) {
      let e = request.resource.data;
      let tp = taskPath(uid,tid);
      let a = get(tp).data;
      let b = getAfter(tp).data;
      return e.keys().hasOnly(['ownerUid','actorUid','taskId','fromVersion','toVersion','type','comment','before','after','createdAt']) &&
        e.keys().hasAll(['ownerUid','actorUid','taskId','fromVersion','toVersion','type','comment','before','after','createdAt']) &&
        e.ownerUid == uid && e.actorUid == uid && e.taskId == tid &&
        e.type is string && e.comment is string &&
        e.fromVersion == a.version && e.toVersion == a.version + 1 &&
        e.before == a && e.after == b && e.createdAt == request.time &&
        b.ownerUid == uid && b.lastEventId == eid && b.version == e.toVersion &&
        b.updatedAt == request.time &&
        validShape(b) && validOp(e.type,a,b,e.comment);
    }
    match /users/{uid}/tasks/{tid} {
      allow get, list: if owner(uid);
      allow create: if owner(uid) && validShape(request.resource.data) &&
        request.resource.data.ownerUid == uid && request.resource.data.lifecycle == 'Draft' &&
        request.resource.data.pauseReason == null && request.resource.data.pausedUntil == null &&
        request.resource.data.actualStart == null && request.resource.data.actualEnd == null &&
        request.resource.data.closureOutcome == null && request.resource.data.version == 0 &&
        request.resource.data.lastEventId == '' &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid) && resource.data.ownerUid == uid &&
        (validOrdinaryUpdate(uid) || validAuditedUpdate(uid,tid));
      allow delete: if false;
      match /activityEvents/{eid} {
        allow get, list: if owner(uid);
        allow create: if owner(uid) && validEventCreate(uid,tid,eid);
        allow update, delete: if false;
      }
    }
  }
}
